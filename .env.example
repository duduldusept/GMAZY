# Copie ce fichier en ".env" (sans ".example") et remplis tes propres valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (voir .gitignore).

# Génère une nouvelle clé avec :
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-moi-avec-une-vraie-cle-secrete-generee

# True en développement local, False (ou absent) en production
DJANGO_DEBUG=True

# Liste de domaines séparés par des virgules, uniquement nécessaire quand DEBUG=False
# Exemple : DJANGO_ALLOWED_HOSTS=monsite.fr,www.monsite.fr
DJANGO_ALLOWED_HOSTS=
